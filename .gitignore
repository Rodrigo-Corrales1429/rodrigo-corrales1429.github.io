# ============================================================================
#  Lo que NUNCA debe salir de esta carpeta
# ============================================================================
#  Este archivo no existía. Sin él, un `git add .` distraído sube la API key
#  de Gemini a un repositorio público — y una clave publicada hay que rotarla,
#  no borrarla: queda en el historial de git y en los rastreadores que
#  escanean GitHub en cuestión de minutos.
# ============================================================================

# Secretos. La plantilla vacía (.env.example) SÍ se versiona; los valores no.
.env
.env.*
!.env.example

# Dependencias: se reconstruyen con `npm ci` desde package-lock.json.
node_modules/

# Ruido de macOS y de editores
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Salidas locales
coverage/
*.tgz

# Los .glb que entrega el generador, en la raíz: pesan ~57 MB cada uno y son
# la MATERIA PRIMA, no lo que sirve el sitio. Lo que se publica son las
# versiones optimizadas de assets/ (~1-2 MB). Git guarda cada versión de un
# binario entera y para siempre: subir los másters aquí infla el repo de forma
# irreversible y hace lento cada clone. Consérvalos fuera del control de
# versiones; la receta para regenerarlos está en MODELO.md.
/*.glb

# Config local del previsualizador (no es del sitio)
.claude/
