{
  "name": "valquiria-inc",
  "version": "2.0.0",
  "description": "Backend del Asesor Valquiria con function calling de Gemini",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test-quote-engine.js && node test-tools-dispatcher.js && node test-verifier-asesor.js && node test-impresion3d.js && node test-carrito.js && node test-phase-1-5.js && node test-envios-avisos.js && node test-asesor-mostrador.js && node --no-warnings test-blindaje-pago.js && node test-hardening.js && node --no-warnings test-seguridad.js",
    "test:carrito": "node test-carrito.js",
    "test:engine": "node test-quote-engine.js",
    "test:tools": "node test-tools-dispatcher.js",
    "test:verifier": "node test-verifier-asesor.js",
    "test:3d": "node test-impresion3d.js",
    "test:phase-1-5": "node test-phase-1-5.js",
    "test:envios": "node test-envios-avisos.js",
    "test:mostrador": "node test-asesor-mostrador.js",
    "test:blindaje": "node --no-warnings test-blindaje-pago.js",
    "test:hardening": "node test-hardening.js",
    "test:persistence": "NODE_ENV=test node test-persistence.js",
    "test:domain": "NODE_ENV=test node test-domain-services.js",
    "db:migrate": "node db/migrate.js",
    "test:seguridad": "node --no-warnings test-seguridad.js",
    "verificar:produccion": "node scripts/verificar-produccion.js",
    "csp": "node scripts/csp-hashes.js",
    "csp:fix": "node scripts/csp-hashes.js --escribir"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "valquiria",
    "asesor",
    "gemini",
    "function-calling"
  ],
  "author": "Valquiria Inc.",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
