# ============================================================================
# Variables de entorno del backend del Asesor Valquiria
# ============================================================================
# Copia este archivo a `.env` y rellena los valores. NUNCA subas el .env real
# a GitHub — agrégalo a tu .gitignore. En Render, configúralas en el panel
# "Environment" del servicio.
# ============================================================================

# --- Obligatoria ---
GEMINI_API_KEY=tu_api_key_real_aqui

# --- Opcionales (con valores default seguros si las omites) ---

# Puerto donde escucha el servidor. Render asigna el suyo automáticamente.
PORT=3000

# Modelo de Gemini. gemini-2.5-flash es el balance ideal coste/calidad.
# Para casos más exigentes podrías usar gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Reglas de envío en CENTAVOS (enteros).
# Ejemplo: 99900 = $999.00 MXN
ENVIO_GRATIS_DESDE_CENTAVOS=99900
COSTO_ENVIO_CENTAVOS=15000

# Tope anti-abuso de cantidad por línea de cotización.
CANTIDAD_MAXIMA_POR_LINEA=200

# --- Pagos (Mercado Pago Checkout Pro) ---
# Guía paso a paso, incluido cómo asociar tu cuenta bancaria: ver PAGOS.md
#
# Access Token de PRODUCCIÓN de tu cuenta de Mercado Pago
# (Panel MP → Tus integraciones → Credenciales de producción). Empieza con
# APP_USR-. Es una LLAVE: quien la tenga puede cobrar en tu nombre.
# Sin esta variable, /api/pago responde 503 y el sitio cierra por WhatsApp.
# Configurarla ENCIENDE los pagos sin tocar código.
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Panel MP → tu aplicación → Webhooks).
# Sin ella el webhook funciona pero NO se valida la firma de quien avisa.
MP_WEBHOOK_SECRET=

# Dominio del sitio, para las URLs de retorno del pago.
SITIO_URL=https://valquiriainc.com

# URL pública de ESTE backend, para que Mercado Pago sepa a dónde notificar.
# Render publica RENDER_EXTERNAL_URL solo, así que normalmente sobra.
BACKEND_URL=

# Tope de mensualidades ofrecidas en el checkout.
MP_MAX_CUOTAS=12

# Tipos de pago a EXCLUIR, separados por coma. Vacío = todo lo que tu cuenta
# tenga habilitado. Ejemplos: ticket (efectivo/OXXO), atm, credit_card.
MP_EXCLUIR_TIPOS=

# Minutos que vive un link de pago antes de caducar (1440 = 24 h).
# Un link eterno es un precio eterno.
MP_VIGENCIA_MINUTOS=1440

# Webhook adonde avisar de cada PAGO APROBADO. Si se omite, se usa
# LEADS_WEBHOOK_URL. Sin ninguno, los pagos solo quedan en los logs.
PEDIDOS_WEBHOOK_URL=

# --- Estimador de impresión 3D (Valquiria 3D) ---
# Tarifa por hora de impresión y pedido mínimo, en CENTAVOS enteros.
# Las tarifas por gramo por material viven en impresion3d.js.
IMP3D_TARIFA_HORA_CENTAVOS=8000
IMP3D_PEDIDO_MINIMO_CENTAVOS=15000

# --- Leads ---
# Token del mirador /api/leads. Se manda en la cabecera X-Leads-Token:
#   curl -H "X-Leads-Token: TU_TOKEN" https://tu-backend/api/leads
# Sin esta variable, el endpoint queda cerrado.
LEADS_TOKEN=

# Webhook opcional adonde mandar cada lead (Zapier, Make, Apps Script...).
LEADS_WEBHOOK_URL=
