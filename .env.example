# ============================================================================
# Variables de entorno del backend del Asesor Valquiria
# ============================================================================
# Copia este archivo a `.env` y rellena los valores. NUNCA subas el .env real
# a GitHub — agrégalo a tu .gitignore. En Render, configúralas en el panel
# "Environment" del servicio.
# ============================================================================

# --- Obligatoria ---
GEMINI_API_KEY=tu_api_key_real_aqui

# --- Opcionales (con valores default seguros si las omites) ---

# Puerto donde escucha el servidor. Render asigna el suyo automáticamente.
PORT=3000

# Modelo de Gemini. gemini-2.5-flash es el balance ideal coste/calidad.
# Para casos más exigentes podrías usar gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Reglas de envío en CENTAVOS (enteros).
# Ejemplo: 99900 = $999.00 MXN
ENVIO_GRATIS_DESDE_CENTAVOS=99900
COSTO_ENVIO_CENTAVOS=15000

# Tope anti-abuso de cantidad por línea de cotización.
CANTIDAD_MAXIMA_POR_LINEA=200

# --- Pagos (Mercado Pago Checkout Pro) ---
# Guía paso a paso, incluido cómo asociar tu cuenta bancaria: ver PAGOS.md
#
# Access Token de PRODUCCIÓN de tu cuenta de Mercado Pago
# (Panel MP → Tus integraciones → Credenciales de producción). Empieza con
# APP_USR-. Es una LLAVE: quien la tenga puede cobrar en tu nombre.
# Sin esta variable, /api/pago responde 503 y el sitio cierra por WhatsApp.
# Configurarla ENCIENDE los pagos sin tocar código.
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Panel MP → tu aplicación → Webhooks).
# Sin ella el webhook funciona pero NO se valida la firma de quien avisa.
MP_WEBHOOK_SECRET=

# Dominio del sitio, para las URLs de retorno del pago.
SITIO_URL=https://valquiriainc.com

# URL pública de ESTE backend, para que Mercado Pago sepa a dónde notificar.
# Render publica RENDER_EXTERNAL_URL solo, así que normalmente sobra.
BACKEND_URL=

# Tope de mensualidades ofrecidas en el checkout.
MP_MAX_CUOTAS=12

# Tipos de pago a EXCLUIR, separados por coma. Vacío = todo lo que tu cuenta
# tenga habilitado. Ejemplos: ticket (efectivo/OXXO), atm, credit_card.
MP_EXCLUIR_TIPOS=

# Minutos que vive un link de pago antes de caducar (1440 = 24 h).
# Un link eterno es un precio eterno.
MP_VIGENCIA_MINUTOS=1440

# Webhook adonde avisar de cada PAGO APROBADO. Si se omite, se usa
# LEADS_WEBHOOK_URL. Sin ninguno, los pagos solo quedan en los logs.
PEDIDOS_WEBHOOK_URL=

# --- Estimador de impresión 3D (Valquiria 3D) ---
# Tarifa por hora de impresión y pedido mínimo, en CENTAVOS enteros.
# Las tarifas por gramo por material viven en impresion3d.js.
IMP3D_TARIFA_HORA_CENTAVOS=8000
IMP3D_PEDIDO_MINIMO_CENTAVOS=15000

# --- Leads ---
# Token del mirador /api/leads. Se manda en la cabecera X-Leads-Token:
#   curl -H "X-Leads-Token: TU_TOKEN" https://tu-backend/api/leads
# Sin esta variable, el endpoint queda cerrado.
LEADS_TOKEN=

# Webhook opcional adonde mandar cada lead (Zapier, Make, Apps Script...).
LEADS_WEBHOOK_URL=

# ============================================================================
# --- AVISOS: cómo te enteras de cada venta ---  (guía completa: AVISOS.md)
# ============================================================================
# Sin ningún canal configurado, un pago aprobado solo escribe una línea en los
# logs de Render. Nadie mira los logs de Render un domingo.

# TELEGRAM — el canal RECOMENDADO. Gratis, instantáneo, sin ventana de 24 h.
# Se saca con @BotFather en 3 minutos. Ver AVISOS.md §2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WHATSAPP (API Cloud de Meta). OJO: fuera de una ventana de 24 h desde que TÚ
# le escribes al número, Meta exige una PLANTILLA aprobada. Ver AVISOS.md §3.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=527717959131
WHATSAPP_PLANTILLA=
WHATSAPP_PLANTILLA_IDIOMA=es_MX

# Webhook genérico (Make, Zapier, n8n). Si se omite, se usa LEADS_WEBHOOK_URL.
AVISOS_WEBHOOK_URL=

# Hora local (0-23) del resumen diario.
AVISOS_HORA_RESUMEN=20
# Cotización que interrumpe al momento en vez de esperar al resumen.
AVISOS_UMBRAL_COTIZACION_CENTAVOS=150000
# Tope de avisos urgentes por hora, para que un bot no se vuelva 400 mensajes.
AVISOS_MAX_POR_HORA=20

# ============================================================================
# --- ENVÍOS: costo, paquetería y fecha de entrega ---  (guía: ENVIOS.md)
# ============================================================================
# "tabla" (por omisión) usa tarifas de referencia y funciona SIN cuenta.
# "envia" o "skydropx" cotizan en vivo. Si la API falla, cae sola a la tabla.
ENVIOS_PROVEEDOR=tabla
ENVIA_API_KEY=
SKYDROPX_API_KEY=

# De dónde salen las cajas y cuánto tarda el taller antes de despachar.
ENVIOS_CP_ORIGEN=42000
ENVIOS_DIAS_PREPARACION=1
ENVIOS_HORA_CORTE=14
ENVIOS_DIVISOR_VOLUMETRICO=6000

# ⚠️ PESA UNA CAJA REAL Y CORRIGE ESTO. Los valores por omisión son estimados
# míos, y un peso mal puesto es dinero perdido en cada guía. Ver ENVIOS.md §3.
ENVIOS_PESOS_JSON=

# ============================================================================
# --- VALQUIRIA PACK: estimador de termoformado ---
# ============================================================================
# Tarifas de referencia del taller. Cuando midas tus costos reales, cámbialas
# aquí y el estimador deja de ser referencia para ser tarifa.
PACK_MOLDE_MINIMO=1200
PACK_MERMA=0.22
PACK_MARGEN_COMERCIAL=1.55
PACK_TIRAJE_MINIMO=100

# ============================================================================
# --- Topes por visitante ---  (subirlos al pasar al plan de pago: IA_PRO.md)
# ============================================================================
RATE_LIMIT_POR_MINUTO=15
RATE_LIMIT_POR_DIA=400
# La telemetría de visitas tiene su PROPIO cupo: con el del chat, alguien que
# abre cinco secciones se gastaría cinco de sus quince mensajes.
RATE_LIMIT_PULSO_POR_MINUTO=40
RATE_LIMIT_PULSO_POR_DIA=600

# "0" = sin razonamiento (rápido y barato). "auto" = el modelo decide.
# Con nueve herramientas, "auto" mejora bastante el acierto. Ver IA_PRO.md.
GEMINI_THINKING_BUDGET=0

# ============================================================================
# --- ENDURECIMIENTO (auditoría del 2026-08-29) ---
# ============================================================================

# Con "production" CORS deja de aceptar orígenes de localhost. Ponlo en Render.
NODE_ENV=production

# Token del panel /admin y de /api/leads. Genéralo así — uno corto se adivina:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El servidor avisa al arrancar si tiene menos de 24 caracteres.
LEADS_TOKEN=

# --- PERSISTENCIA ---
# SIN esto, pedidos, intereses y bitácora se BORRAN cuando Render reinicia.
# El sistema de archivos de Render es efímero, así que hace falta un disco:
#   Render → tu servicio → Disks → Add Disk → Mount path /var/data → 1 GB
# y luego:
ALMACEN_RUTA=
# ALMACEN_RUTA=/var/data/valquiria.json
ALMACEN_INTERVALO_MS=30000

# --- IMPUESTOS ---
# AFIRMACIÓN FISCAL, no decoración: con true el carrito muestra "IVA incluido".
# Si tu régimen no traslada IVA, ponlo en false (los precios no cambian; solo
# se deja de afirmar algo que no es cierto). Debe coincidir con app.js.
PRECIOS_LLEVAN_IVA=true
IVA_TASA=0.16

# --- INVENTARIO ---
# Minutos que se aparta la mercancía al generar un link de pago. Nunca menor
# que MP_VIGENCIA_MINUTOS, o alguien podría pagar algo ya vendido.
INVENTARIO_MINUTOS_RESERVA=1440

# --- LÍMITES DEFENSIVOS ---
# Caracteres sumados de todo el historial en una petición al Asesor.
MAX_CARACTERES_HISTORIAL=24000
# Timeout de UNA llamada a Gemini. El límite de Render NO es el techo aquí.
GEMINI_TIMEOUT_MS=45000

# Silencia los avisos (lo usan las pruebas para no mandarte pagos falsos).
AVISOS_SILENCIO=
