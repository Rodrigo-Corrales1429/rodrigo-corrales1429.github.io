# ============================================================================
# Variables de entorno del backend del Asesor Valquiria
# ============================================================================
# Copia este archivo a `.env` y rellena los valores. NUNCA subas el .env real
# a GitHub — agrégalo a tu .gitignore. En Render, configúralas en el panel
# "Environment" del servicio.
# ============================================================================

# --- Obligatoria ---
GEMINI_API_KEY=tu_api_key_real_aqui

# --- Opcionales (con valores default seguros si las omites) ---

# --- Comercio PostgreSQL (opt-in; requiere migraciones explícitas y cutover) ---
# Vacío sin DATABASE_URL conserva legacy antes del cutover. Con SQL no hay fallback.
# En producción tras el cutover: postgres. No volver a legacy con pedidos SQL vivos.
PERSISTENCIA=
# Configura estas variables en el entorno privado del backend. No publiques la URL.
DATABASE_URL=
# Clave privada HMAC, hex de >=32 bytes ALEATORIOS, sin default.
COMMERCE_HMAC_KEY=
# Cuenta cobradora, verificada contra collector_id del pago.
MP_ACCOUNT_ID=
# production en producción; sandbox sólo con credenciales de test.
MP_ENVIRONMENT=
# Todo destino remoto exige verify-full, incluso fuera de producción; CA privada opcional.
DATABASE_TLS=verify-full
DATABASE_CA_FILE=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
# Solo para test:persistence, test:domain y test:commerce: base de prueba DESECHABLE,
# separada de producción, local (localhost/127.0.0.1/[::1]) y llamada valquiria_test.
# Las suites exigen NODE_ENV=test, DATABASE_URL ausente y esta marca, que se pone a
# mano al crear la base (nunca en una base real):
#   COMMENT ON DATABASE valquiria_test IS 'valquiria:disposable-test';
TEST_DATABASE_URL=

# Puerto donde escucha el servidor. Render asigna el suyo automáticamente.
PORT=3000

# Modelo de Gemini. gemini-2.5-flash es el balance ideal coste/calidad.
# Para casos más exigentes podrías usar gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Reglas de envío en CENTAVOS (enteros).
# Ejemplo: 100000 = $1,000.00 MXN
ENVIO_GRATIS_DESDE_CENTAVOS=100000
COSTO_ENVIO_CENTAVOS=15000

# Tope anti-abuso de cantidad por línea de cotización.
CANTIDAD_MAXIMA_POR_LINEA=200

# --- Pagos (Mercado Pago Checkout Pro) ---
# Guía paso a paso, incluido cómo asociar tu cuenta bancaria: ver PAGOS.md
#
# Access Token de PRODUCCIÓN de tu cuenta de Mercado Pago
# (Panel MP → Tus integraciones → Credenciales de producción). Empieza con
# APP_USR-. Es una LLAVE: quien la tenga puede cobrar en tu nombre.
# Sin esta variable, /api/pago responde 503 y el sitio cierra por WhatsApp.
# Configurarla ENCIENDE los pagos sin tocar código.
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Panel MP → tu aplicación → Webhooks).
# Sin ella el webhook devuelve 503: nunca procesa un aviso sin firma verificable.
MP_WEBHOOK_SECRET=

# Dominio del sitio, para las URLs de retorno del pago.
SITIO_URL=https://valquiriainc.com

# URL pública de ESTE backend, para que Mercado Pago sepa a dónde notificar.
# Render publica RENDER_EXTERNAL_URL solo, así que normalmente sobra.
BACKEND_URL=

# Tope de mensualidades ofrecidas en el checkout.
MP_MAX_CUOTAS=12

# Tipos de pago a EXCLUIR, separados por coma. Vacío = todo lo que tu cuenta
# tenga habilitado. Ejemplos: ticket (efectivo/OXXO), atm, credit_card.
MP_EXCLUIR_TIPOS=

# Minutos que vive un link de pago antes de caducar. Bajó de 1440 a 60.
# Un link eterno es un precio eterno; y mientras estuvo atado a la reserva de
# inventario, era además una palanca: una sola petición apartaba mercancía 24 h.
# Si activas pagos en efectivo o SPEI —que se liquidan en días— súbelo. Un pago
# que llega con la reserva ya caducada se registra igual, pero el aviso lo dice
# para que compruebes el stock antes de prometer fecha.
MP_VIGENCIA_MINUTOS=60

# Solo para PRUEBAS: apunta la API de Mercado Pago a otro sitio. En producción
# NO se define. Existe para que `npm test` pueda ejercitar el webhook completo
# —firma, consulta del pago, cuadre del importe, inventario y aviso— contra un
# Mercado Pago falso, sin cobrarle a nadie.
MP_API_URL=

# Webhook adonde avisar de cada PAGO APROBADO. Si se omite, se usa
# LEADS_WEBHOOK_URL. En modo SQL sin canal queda pendiente durable en outbox;
# requiere atención operacional, no revierte una venta.
PEDIDOS_WEBHOOK_URL=

# --- Estimador de impresión 3D (Valquiria 3D) ---
# Tarifa por hora de impresión y pedido mínimo, en CENTAVOS enteros.
# Las tarifas por gramo por material viven en impresion3d.js.
IMP3D_TARIFA_HORA_CENTAVOS=8000
IMP3D_PEDIDO_MINIMO_CENTAVOS=15000

# --- Leads ---
# Token del mirador /api/leads. Se manda en la cabecera X-Leads-Token:
#   curl -H "X-Leads-Token: TU_TOKEN" https://tu-backend/api/leads
# Sin esta variable, el endpoint queda cerrado.
LEADS_TOKEN=

# Webhook opcional adonde mandar cada lead (Zapier, Make, Apps Script...).
LEADS_WEBHOOK_URL=

# ============================================================================
# --- AVISOS: cómo te enteras de cada venta ---  (guía completa: AVISOS.md)
# ============================================================================
# Sin ningún canal configurado, un pago aprobado solo escribe una línea en los
# logs de Render. Nadie mira los logs de Render un domingo.

# TELEGRAM — el canal RECOMENDADO. Gratis, instantáneo, sin ventana de 24 h.
# Se saca con @BotFather en 3 minutos. Ver AVISOS.md §2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WHATSAPP (API Cloud de Meta). OJO: fuera de una ventana de 24 h desde que TÚ
# le escribes al número, Meta exige una PLANTILLA aprobada. Ver AVISOS.md §3.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=527717959131
WHATSAPP_PLANTILLA=
WHATSAPP_PLANTILLA_IDIOMA=es_MX

# Webhook genérico (Make, Zapier, n8n). Si se omite, se usa LEADS_WEBHOOK_URL.
AVISOS_WEBHOOK_URL=

# Hora local (0-23) del resumen diario.
AVISOS_HORA_RESUMEN=20
# Cotización que interrumpe al momento en vez de esperar al resumen.
AVISOS_UMBRAL_COTIZACION_CENTAVOS=150000
# Tope de avisos urgentes por hora, para que un bot no se vuelva 400 mensajes.
AVISOS_MAX_POR_HORA=20

# ============================================================================
# --- ENVÍOS: costo, paquetería y fecha de entrega ---  (guía: ENVIOS.md)
# ============================================================================
# "auto" consulta Envia y Skydropx en paralelo cuando sus credenciales existen.
# Si no hay proveedor utilizable, cae a la tabla local y lo declara estimado.
ENVIOS_PROVEEDOR=auto
ENVIA_API_KEY=
SKYDROPX_API_KEY=

# Costos/política en centavos. La maniobra se incorpora al precio total cuando
# el cliente paga envío; nunca se publica como concepto separado.
ENVIOS_MANIOBRA_CENTAVOS=3500
ENVIOS_PREMIO_RAPIDEZ_CENTAVOS=6000
ENVIOS_UPGRADE_GRATIS_CENTAVOS=4000

# Skydropx necesita dirección de origen estructurada. Es preferible usar la
# plantilla creada en la cuenta; si no, configura municipio y colonia reales.
SKYDROPX_ORIGEN_TEMPLATE_ID=
SKYDROPX_ORIGEN_AREA_LEVEL2=
SKYDROPX_ORIGEN_AREA_LEVEL3=

# De dónde salen las cajas y cuánto tarda el taller antes de despachar.
ENVIOS_CP_ORIGEN=42000
ENVIOS_DIAS_PREPARACION=1
ENVIOS_HORA_CORTE=14
ENVIOS_DIVISOR_VOLUMETRICO=6000

# ⚠️ PESA UNA CAJA REAL Y CORRIGE ESTO. Los valores por omisión son estimados
# míos, y un peso mal puesto es dinero perdido en cada guía. Ver ENVIOS.md §3.
ENVIOS_PESOS_JSON=

# ============================================================================
# --- VALQUIRIA PACK: estimador de termoformado ---
# ============================================================================
# Tarifas de referencia del taller. Cuando midas tus costos reales, cámbialas
# aquí y el estimador deja de ser referencia para ser tarifa.
PACK_MOLDE_MINIMO=1200
PACK_MERMA=0.22
PACK_MARGEN_COMERCIAL=1.55
PACK_TIRAJE_MINIMO=100

# ============================================================================
# --- Topes por visitante ---  (subirlos al pasar al plan de pago: IA_PRO.md)
# ============================================================================
# 30, no 15. Quince por minuto es hostil con quien escribe tres mensajes
# cortos seguidos desde el teléfono —y con el dueño probando su propia
# tienda—. Sigue habiendo tope, y debajo está el diario: esto frena bucles
# automatizados, no conversaciones. El 429 que devuelve este tope NO es el de
# Google: incluye `espera_s` y el Asesor lo dice tal cual («ocupado ~12 s»)
# sin perder el carrito del cliente.
RATE_LIMIT_POR_MINUTO=30
RATE_LIMIT_POR_DIA=400
# La telemetría de visitas tiene su PROPIO cupo: con el del chat, alguien que
# abre cinco secciones se gastaría cinco de sus quince mensajes.
RATE_LIMIT_PULSO_POR_MINUTO=40
RATE_LIMIT_PULSO_POR_DIA=600

# "0" = sin razonamiento (rápido y barato). "auto" = el modelo decide.
# Con nueve herramientas, "auto" mejora bastante el acierto. Ver IA_PRO.md.
#
# Recomendación para el checkout: si notas que el Asesor se equivoca armando
# pedidos de varias líneas o pidiendo los datos de entrega, pon "auto". Cuesta
# más por turno, pero el turno que se equivoca cuesta la venta entera.
#
# LOS CRÉDITOS SE CARGAN EN https://aistudio.google.com/ (Get API key →
# facturación del proyecto). Ojo con confundir dos 429 distintos:
#   · 429 de Google  → se acabó tu cuota/crédito de Gemini. Se arregla en AI
#     Studio. En los logs sale como `cuota-gemini`.
#   · 429 de este servidor → RATE_LIMIT_POR_MINUTO, aquí arriba. Se arregla
#     subiendo el número. En los logs sale como `[rate-limit:chat]`.
# La API key NUNCA va en el repositorio: solo en el panel de Render.
GEMINI_THINKING_BUDGET=0

# ============================================================================
# --- ENDURECIMIENTO (auditoría del 2026-08-29) ---
# ============================================================================

# Localhost solo se acepta con NODE_ENV=development. Pon production en Render.
NODE_ENV=production

# Opcional: añade orígenes HTTPS exactos, separados por coma. Los tres
# orígenes actuales siempre se conservan. Nunca uses * ni localhost aquí.
# CORS_ORIGENES=https://staging.example

# Token del panel /admin y de /api/leads. Genéralo así — uno corto se adivina:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El servidor avisa al arrancar si tiene menos de 24 caracteres.
LEADS_TOKEN=

# --- PERSISTENCIA ---
# SIN esto, pedidos, intereses y bitácora se BORRAN cuando Render reinicia.
# El sistema de archivos de Render es efímero, así que hace falta un disco:
#   Render → tu servicio → Disks → Add Disk → Mount path /var/data → 1 GB
# y luego:
ALMACEN_RUTA=
# ALMACEN_RUTA=/var/data/valquiria.json
ALMACEN_INTERVALO_MS=30000

# --- IMPUESTOS ---
# AFIRMACIÓN FISCAL, no decoración: con true el carrito muestra "IVA incluido".
# Si tu régimen no traslada IVA, ponlo en false (los precios no cambian; solo
# se deja de afirmar algo que no es cierto). Debe coincidir con app.js.
PRECIOS_LLEVAN_IVA=true
IVA_TASA=0.16

# --- INVENTARIO ---
# Minutos que se aparta la mercancía al generar un link de pago.
#
# QUINCE, no 1440. La regla anterior era «nunca menor que MP_VIGENCIA_MINUTOS»,
# que sonaba prudente y salía carísima: bastaba UNA petición pidiendo todas las
# unidades de un producto para dejarlo en cero durante un día, sin pagar un peso
# y sin pasar por ningún límite (el tope de 6 peticiones/minuto no frena a quien
# solo necesita una).
#
# Quince minutos es lo que tarda una compra con tarjeta. Lo que tarda más se
# resuelve en el webhook: si el pago entra con la reserva caducada, la venta se
# registra igual y el aviso avisa de que hay que comprobar el stock.
#
# OJO: este número está TOPADO a 60 minutos en el código. Un despliegue no
# limpia el panel de Render, y un 1440 heredado devolvería el agujero entero
# sin que nadie tocara una línea. Aun así, corrígelo en Render: el techo es la
# red de seguridad, no la configuración.
INVENTARIO_MINUTOS_RESERVA=15

# Topes de UNA compra en línea. El autoservicio no es el canal de mayoreo —el
# sitio manda a WhatsApp a quien compra por volumen—, así que limitarlo no
# cierra ninguna venta real y sí cierra el desabasto por diversión.
# El rechazo es un 400 que ofrece el canal de mayoreo, no un portazo.
INVENTARIO_MAX_POR_SKU=6
INVENTARIO_MAX_UNIDADES=12

# Reservas vivas a la vez por visitante. UNA: tres por identidad son dieciocho
# piezas de un mismo producto en manos de quien no ha pagado nada. Abrir un
# pedido nuevo REEMPLAZA el anterior en vez de rechazarlo, así que quien deja
# un pago a medias y vuelve a intentarlo no se queda bloqueado.
INVENTARIO_MAX_RESERVAS_POR_IDENTIDAD=1

# EL TECHO QUE NO DEPENDE DE QUIÉN PIDA.
# Los topes de arriba son por visitante, y un visitante son cinco pestañas o
# cinco IPs: con reserva de 15 min, 6 por SKU y 3 por identidad, dos
# identidades bastaban para dejar un producto de 27 piezas en cero.
#
# Esto es lo que de verdad protege el mostrador: las reservas SIN PAGAR nunca
# retienen más de esta fracción de lo que queda por vender, vengan de donde
# vengan. Las ventas confirmadas no cuentan aquí — esas son reales.
# 0.5 = siempre queda comprable la mitad. Bajarlo protege más y frena antes
# una racha buena de ventas.
INVENTARIO_FRACCION_RESERVABLE=0.5

# Piezas que NUNCA se apartan sin pagar, por encima de lo que diga la fracción.
# Con stock bajo la fracción sola no basta: de 1 pieza, la mitad redondea a 0 y
# la última se colaría. Con esto, quien entra a comprar de verdad SIEMPRE
# encuentra algo que comprar.
#
# Consecuencia asumida: la última pieza no se aparta de forma anónima. No se
# puede sostener a la vez «un bot nunca aparta la última» y «cualquier anónimo
# puede apartar la última». Se protege la pieza; quien la quiera la cierra por
# WhatsApp, y ahí hay una persona mirando. El rechazo lo dice con esas palabras.
INVENTARIO_STOCK_SEGURIDAD=1

# --- LÍMITES DEFENSIVOS ---
# Caracteres sumados de todo el historial en una petición al Asesor.
MAX_CARACTERES_HISTORIAL=24000
# Timeout de UNA llamada a Gemini. El límite de Render NO es el techo aquí.
GEMINI_TIMEOUT_MS=45000

# Silencia los avisos (lo usan las pruebas para no mandarte pagos falsos).
AVISOS_SILENCIO=

# ============================================================================
# --- CHECKOUT: sin contacto no hay link ---
# ============================================================================
# No hay variable que apagar: /api/pago RECHAZA con 400 cualquier pedido sin
# nombre, WhatsApp (10 dígitos), correo, código postal y calle con número. El
# 400 dice en `faltan` qué campo es, y el Asesor lo pregunta en el chat.
#
# El motivo es operativo, no burocrático: un pago que se queda a medias sin
# contacto es un pedido que nadie puede rescatar. Con estos datos, el aviso de
# Telegram de cada pago —aprobado, pendiente o rechazado— trae el WhatsApp y
# la dirección del comprador, y se puede empacar o escribir sin abrir el panel
# de Mercado Pago.
#
# Las URLs de retorno de Mercado Pago apuntan a https://<SITIO_URL>/gracias/
# (ruta real, sin `#`). Si cambias SITIO_URL, esa página tiene que existir en
# el dominio nuevo o el comprador vuelve a un 404 después de pagar.

# ============================================================================
# --- SEGURIDAD (auditoría de los 20 puntos, 26-09-2026) ---
# ============================================================================

# De dónde sale la IP REAL del visitante (para rate limits y el bloqueo del
# panel, nunca para decir de quién es una reserva). Render sirve detrás de
# Cloudflare y `req.ip` es la IP de salida de Cloudflare, que ROTA; la real
# viene en CF-Connecting-IP. El servidor solo la cree con RENDER=true —Render
# la pone sola— y fuera de Render usa la del socket: ahí cualquiera elige esa
# cabecera. Esta variable ya NO elige cabecera: solo puede apagar la
# confianza. Déjala así; vacía, no se cree ninguna (ver identidad.js).
IP_CABECERA_CONFIABLE=cf-connecting-ip

# El panel: horas que dura una sesión (1 a 24). El token maestro se teclea una
# vez, se cambia por una sesión firmada y NO se guarda en el navegador. Rotar
# LEADS_TOKEN cierra todas las sesiones abiertas. OJO: LEADS_TOKEN de menos de
# 24 caracteres deja el panel CERRADO a propósito — un secreto corto se adivina.
ADMIN_SESION_HORAS=8
RATE_LIMIT_ADMIN_POR_MINUTO=20
RATE_LIMIT_ADMIN_POR_DIA=400

# Techo GLOBAL de llamadas a Gemini, de todos los visitantes juntos. El límite
# por IP frena a una persona, no a mil. Al llegar al tope el Asesor sigue en
# modo local (desglosa el carrito y cierra por WhatsApp) y te llega un aviso.
# Cuentas rápidas con gemini-2.5-flash y thinking "auto": ~1 centavo de dólar
# por llamada en el peor caso → 600/día ≈ 6 USD/día como máximo.
GEMINI_TOPE_DIARIO=600
GEMINI_TOPE_MINUTO=60

# Solo para PRUEBAS, como MP_API_URL: apunta el SDK de Gemini a un servidor
# falso. En producción NO se define.
GEMINI_BASE_URL=
